{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: Build Active Module",
            "type": "shell",
            "command": "cl",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe:${fileDirname}\\main.exe",
                "${fileDirname}\\main.cpp",
                "${workspaceFolder}\\HelperFunctions\\helperfunctions.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds all .cpp files in the workspace using cl.exe"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}